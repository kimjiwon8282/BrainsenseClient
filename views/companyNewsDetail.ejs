<%- include('partials/header', { title: post.title }) %>
<link rel="stylesheet" href="/css/newsDetail.css" />
<link rel="stylesheet" href="/css/commonCp.css" />

<div class="company_introPage">
  <!-- 배경이미지 -->
  <div class="company_introimg">
    <img src="/images/company_intro_bg.jpg" alt="인트로 이미지" />
    <!-- ✅ 오버레이 추가 -->
    <div class="company_img-overlay"></div>
  </div>
  <div class="company_content">
    <p>기업</p>
    <h1>감각을 통한 일상 속의 새로운 변화</h1>
  </div>
  <div class="company_path">
    <div class="first">
      <a href="#" id="btn-intro" class="second">회사소개</a>
    </div>
    <div class="first">
      <a href="#" id="btn-perform" class="second">성과 및 실적</a>
    </div>
    <div class="first">
      <a href="#" id="btn-news" class="second">NEWS</a>
    </div>
    <div class="first">
      <a href="#" id="btn-team" class="second">팀소개</a>
    </div>
  </div>
</div>

<div class="id_container">
  <!-- 제목 -->
  <div class="id_header"><%= post.title %></div>
  
  <!-- 날짜 및 출처 -->
  <div class="id_header2">
    <% 
      const createdAt = new Date(post.createdAt);
      const y = createdAt.getFullYear();
      const m = String(createdAt.getMonth() + 1).padStart(2, '0');
      const d = String(createdAt.getDate()).padStart(2, '0');
      const dateStr = `${y}.${m}.${d}`;
      const source = post.source;
    %>
    <%= dateStr %> | <%= source %>
  </div>
  
  <!-- 구분선 -->
  <div class="id_hz"></div>
  
  <!-- 뉴스 텍스트 내용 및 이미지 추출 -->
  <% 
    // 모든 <img> 태그의 src를 전역 정규표현식으로 추출하여 배열에 저장
    let imageArray = [];
    const imgRegexGlobal = /<img\s+[^>]*src="([^"]+)"[^>]*>/gi;
    let matchArr;
    while ((matchArr = imgRegexGlobal.exec(post.content)) !== null) {
      imageArray.push(matchArr[1]);
    }
    // 이미지 태그들을 모두 제거한 텍스트 콘텐츠
    const imgRegexForReplace = /<img\s+[^>]*src="([^"]+)"[^>]*>/gi;
    let cleanedContent = post.content.replace(imgRegexForReplace, '');
  %>
  
  <!-- 뉴스 텍스트 내용 -->
  <div class="id_content"><%- cleanedContent %></div>
  
  <!-- 뉴스 이미지 슬라이더 (이미지가 있을 때만 렌더링) -->
  <% if (imageArray.length > 0) { %>
    <div class="id_img" style="position: relative; background-color: transparent;">
      <% if (imageArray.length > 1) { %>
        <button class="slider-prev" onclick="prevSlide()" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); z-index: 2;">&#10094;</button>
      <% } %>
      <img id="slider-image" src="<%= imageArray[0] %>" alt="뉴스 이미지" style="width: 100%; height: 100%; object-fit: contain; object-position: center; background-color: transparent; margin-bottom: 10px;" />
      <% if (imageArray.length > 1) { %>
        <button class="slider-next" onclick="nextSlide()" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); z-index: 2;">&#10095;</button>
      <% } %>
    </div>
  <% } %>
  
<!-- 첨부파일 영역 (디자인 수정 적용) -->
<% if (post.attachments && post.attachments.length > 0) { %>
  <div class="id_link_container">
    <div class="id_link_head">
      <div class="id_text" style="margin-top: 30px;">첨부파일</div>
    </div>
    <div class="id_link">
      <% post.attachments.forEach(function(file) { 
          // 파일 경로는 "/uploads/파일명" 형태로 저장됨
          const fileName = file.originalName;
          const fileUrl = file.safeName.startsWith('/uploads/') ? file.safeName : '/uploads/' + file.safeName;
           const fileExt = fileName.split(".").pop().toLowerCase();
           const previewableExtensions = ['pdf', 'png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'];
      %>
      <div class="id_link_text">
        <a href="<%= fileUrl %>" download="<%= fileName %>" target="_blank" class="viewer-link">
          <%= fileName %>
        </a>
        <button class="id_viewer" data-file-url="<%= fileUrl %>">미리보기</button>
      </div>
      <% }); %>
    </div> 
  </div>
<% } %>

  
  <!-- 목록 보기 버튼 -->
  <div class="id_list">목록 보기</div>
</div>

<!-- 전역 변수 images에 imageArray 전달 -->
<div id="dataHolder" data-images='<%- JSON.stringify(imageArray) %>'></div>
<script>
  var dataHolder = document.getElementById('dataHolder');
  var images = JSON.parse(dataHolder.getAttribute('data-images'));
  var currentSlide = 0;
</script>
<!-- 슬라이더 스크립트를 외부 파일로 로드 -->
<script src="/js/newsDetail.js"></script>
<script src="/js/companyPath.js"></script>
<%- include('partials/footer') %>